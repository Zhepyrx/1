# Required: Anthropic API key for drafting
ANTHROPIC_API_KEY=sk-ant-...

# Required: GitHub personal access token (public_repo scope is enough)
# Used for higher rate limits on GitHub search/issue endpoints.
GITHUB_TOKEN=ghp_...

# Optional: filter by skills. Comma-separated.
# Common values: typescript,javascript,python,rust,go,ruby,java
SKILLS=typescript,javascript,python

# Optional: minimum bounty in USD. Below this, candidates are dropped.
MIN_BOUNTY_USD=50

# Optional: cap how many candidates we draft per run (Claude API cost control).
MAX_DRAFTS_PER_RUN=10

# Optional: where to write reports. Defaults to ./reports
REPORTS_DIR=./reports

# Optional: where to put the SQLite state DB. Defaults to ./state.db
DB_PATH=./state.db

# Optional: webhook for daily report (Discord, Slack incoming-webhook, etc.)
# WEBHOOK_URL=https://discord.com/api/webhooks/...
